# ==============================================================================
# .gitignore - Web Portal Masjid Musafir Sophia Jatiwarna
# Standard: Node.js, Vercel, Supabase, Env Security, Cache & Log Hardening
# ==============================================================================

# Kredensial & Berkas Rahasia (Strict Zero-Leak)
credentials.txt
credentials*.txt
PORTAL_CREDENTIALS.txt
AKUN_ADMIN_PORTAL.txt
AKUN_PENGURUS_DKM.txt
*.csv
*.xlsx
.env
.env*.local
.env.development
.env.production
.env.staging
*.pem
*.key
*.cert
*.pfx
*.p12
~$*
*.tmp
*.temp

# Ketergantungan Node.js & Manajer Paket
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
package-lock.json.bak
yarn.lock.bak

# Artefak Kompilasi & Build
dist/
build/
out/
.output/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/

# Hosting & Edge Server Cache (Vercel)
.vercel/
.vercel_build_output/

# Supabase Local Development Temp Files
.supabase/
supabase/.temp/
supabase/.branches/

# Berkas Log & Analisis Jaringan
*.log
logs/
*.har
*.pid
*.seed
*.pid.lock

# Berkas Sementara & Ekstensi Editor / IDE
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak

# Berkas Backup & Media Mentah Berukuran Besar (>50MB)
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.tar.gz
*.rar
*.7z
*.backup
*.sql.gz
asset/images/

# Direktori Uji Coba & Arsip Internal Sementara
.agents/
scratch/
tmp/
temp/
